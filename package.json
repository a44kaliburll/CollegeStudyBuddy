{
  "name": "campus-hub",
  "private": true,
  "version": "1.0.0",
  "description": "Campus Hub — a playful, fully featured college student planner. Local-only data, no accounts.",
  "author": "a44kaliburll",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "app:exe": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.campushub.app",
    "productName": "Campus Hub",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "CampusHub-${version}.exe"
    }
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.2.7",
    "@fontsource/nunito": "^5.2.7",
    "@tailwindcss/vite": "^4.3.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
